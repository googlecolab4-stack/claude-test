# Copia in .env (non versionato) e adatta. Nessuna credenziale necessaria.
# Indirizzo del server LM Studio (in Docker: http://host.docker.internal:1234/v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Id del modello restituito da GET /v1/models. Se vuoto l'app elenca gli id e termina.
LMSTUDIO_MODEL=
# Opzionali
MAX_PASSAGGI=5
LOG_LEVEL=INFO
